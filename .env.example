# ── Database (Postgres + pgvector) ─────────────────────────────────────────────
DB_NAME=poptalk_rag
DB_USERNAME=poptalk_rag
DB_PASSWORD=choose_a_strong_password
DB_PORT=5433

# ── Embeddings ──────────────────────────────────────────────────────────────────
# ollama (default, free/local) or openai
EMBEDDING_PROVIDER=ollama
# Must match the embedding model's actual output size, or pgvector rejects
# every insert: nomic-embed-text=768, text-embedding-3-small=1536.
EMBEDDING_DIMENSIONS=768

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Auth — the ONLY source of tenant identity ───────────────────────────────────
# personaId:key,personaId2:key2 — give each PopTalk persona using this server
# its own key (set as mcp-api-key= in that persona's persona.properties).
PERSONA_API_KEYS=

# ── Ingestion ─────────────────────────────────────────────────────────────────
KNOWLEDGE_DIR=./knowledge
KNOWLEDGE_POLL_INTERVAL_MS=60000

# ── Runtime ───────────────────────────────────────────────────────────────────
HOST_PORT=8090
