# ── Database (Postgres + pgvector) ─────────────────────────────────────────────
DB_NAME=poptalk_rag
DB_USERNAME=poptalk_rag
DB_PASSWORD=choose_a_strong_password
DB_PORT=5433

# ── Embeddings ──────────────────────────────────────────────────────────────────
# ollama (default, free/local) or openai
EMBEDDING_PROVIDER=ollama
# Must match the embedding model's actual output size, or pgvector rejects
# every insert: nomic-embed-text=768, text-embedding-3-small=1536.
EMBEDDING_DIMENSIONS=768

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Retrieval ranking ─────────────────────────────────────────────────────────
# Cosine-similarity floor (0.0-1.0) below which a match is dropped entirely —
# without this, low-relevance chunks pad out to topK instead of being
# excluded. Needs tuning per embedding model; 0.5 is a starting point.
SIMILARITY_THRESHOLD=0.5

# Reserved persona id (a folder under knowledge/) whose documents every
# persona can retrieve in addition to their own — shared knowledge across
# personas without duplicating files.
SHARED_PERSONA_ID=_shared

# Hard cap on the total characters search_knowledge_base returns, regardless
# of topK — keeps a misconfigured client from blowing the context budget.
MAX_CONTEXT_CHARS=6000

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
MIN_CHUNK_SIZE_CHARS=350
# Trailing characters of a chunk carried into the next one, since the
# splitter itself has no overlap — reduces context loss at chunk boundaries.
CHUNK_OVERLAP_CHARS=100

# ── Hybrid search ────────────────────────────────────────────────────────────
# Adds a Postgres full-text-search leg alongside vector similarity (merged
# via Reciprocal Rank Fusion) — catches exact-term queries pure embedding
# search can miss.
HYBRID_SEARCH_ENABLED=true

# Reranks the vector search's candidates with a chat model before returning
# the requested topK — cosine similarity alone is a fairly blunt signal.
# Falls back to plain vector-similarity order if disabled or the call fails.
RERANK_ENABLED=true
# ollama (default) or openai — independent of EMBEDDING_PROVIDER, since
# reranking needs a chat/instruct model, not an embedding encoder.
RERANK_PROVIDER=ollama
RERANK_MODEL=llama3.2
# How many candidates to fetch before reranking, relative to topK (capped).
RERANK_CANDIDATE_POOL_MULTIPLIER=4
RERANK_MAX_CANDIDATE_POOL=20

# ── Auth — the ONLY source of tenant identity ───────────────────────────────────
# personaId:key,personaId2:key2 — give each PopTalk persona using this server
# its own key (set as mcp-api-key= in that persona's persona.properties).
PERSONA_API_KEYS=

# ── Ingestion ─────────────────────────────────────────────────────────────────
KNOWLEDGE_DIR=./knowledge
KNOWLEDGE_POLL_INTERVAL_MS=60000

# ── Runtime ───────────────────────────────────────────────────────────────────
HOST_PORT=8090
